# ==============================================================================
# RULER Regulatory Intelligence — Environment Configuration Template
#
# IMPORTANT: The frontend (Next.js) and backend (FastAPI) are deployed as
# TWO SEPARATE services. Do not copy this whole file into both deployments —
# each service only needs its own section below.
# ==============================================================================

# ------------------------------------------------------------------
# FRONTEND (Netlify / Next.js) — set these in the frontend's deploy env
# ------------------------------------------------------------------

# Server-Side Administrative Passkey & Session Signing Secret
# (NEVER prefix with NEXT_PUBLIC_ or expose to client-side code)
ADMIN_PASSKEY=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Public URL of the deployed backend (FastAPI on Render, etc). The Next.js
# server proxies all /api/* requests here — must be reachable from the
# frontend's host. Example: https://your-backend.onrender.com
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------
# BACKEND (Render / FastAPI) — set these in the backend's deploy env
# ------------------------------------------------------------------

# Public URL of the deployed frontend (Netlify, etc). Used only to build the
# "/" redirect/landing page served by the backend. Example:
# https://your-frontend.netlify.app
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the FastAPI backend's CORS
# policy. Leave as "*" for local dev; set to your deployed frontend's exact
# origin (e.g. https://your-frontend.netlify.app) in production.
ALLOWED_ORIGINS=*

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ruler_rag_db

# LLM & Embedding Inference Configuration
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-with-your-api-key
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
